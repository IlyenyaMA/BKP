// Code for controlling a mobile conveyor
#include <bur/plctypes.h>
#ifdef _DEFAULT_INCLUDES
#include <AsDefault.h>
#endif
 
void _INIT ProgramInit(void)
{
    // init all variables
    pwmPeriod = 26;
    gEncCounter = 0;
    prevCounter = 0;
    
    // init PID parameters
    PID.MinOut = -32767; // min pwm value (reverse)
    PID.MaxOut = 32767; // max pwm value (forward)
    PID.PIDParameters.Gain = 15; // tuned parameters
    PID.PIDParameters.IntegrationTime = 0.05;    
}
 
void _CYCLIC ProgramCyclic(void)
{
    if(gConvEnableF)
    {
        PID.SetValue = gConvSpeed; // = -250, max 3300?
        PID.Enable = 1;
    }
    else if(gConvEnableR)
    {
        PID.SetValue = -gConvSpeed; // = -250, max 3300?
        PID.Enable = 1;
    }
    else
    {
        PID.SetValue = 0;
        PID.Enable = 0;
    }
    
    if(abs(gEncCounter - prevCounter) < 32000) // to avoid speed jump when counter overflows
        speed = -(gEncCounter - prevCounter) / 0.02; // speed is negative when pwm is positive; 0.02 - current cyclic time
    PID.ActValue = speed; // input speed into PID
    MTBasicsPID(&PID); // execute PID
    pwmValue = PID.Out; // out is going to the motor
    prevCounter = gEncCounter; // save counter for next cycle
}
 
void _EXIT ProgramExit(void)
{
    
}
